    "Rationale": {
     "id": "e%3DE%3E",
     "type": "rich_text",
     "rich_text": [
      {
       "type": "text",
       "text": {
        "content": "The current promotion rule requires Candidate.Parent Version ID = current Approved Version ID, but the registry currently has no Approved Version. Without a bootstrap clause, the first approval is structurally impossible.",
        "link": null
       },
       "annotations": {
        "bold": false,
        "italic": false,
        "strikethrough": false,
        "underline": false,
        "code": false,
        "color": "default"
       },
       "plain_text": "The current promotion rule requires Candidate.Parent Version ID = current Approved Version ID, but the registry currently has no Approved Version. Without a bootstrap clause, the first approval is structurally impossible.",
       "href": null
      }
     ]
    },
    "Alternatives Considered": {
     "id": "wyas",
     "type": "rich_text",
     "rich_text": [
      {
       "type": "text",
       "text": {
        "content": "1) Keep current rule and accept a deadlock. 2) Allow first approval from latest validated lineage candidate when Approved is empty, then enforce normal Parent=Current Approved afterward. 3) Create an artificial v0 Approved baseline.",
        "link": null
       },
       "annotations": {
        "bold": false,
        "italic": false,
        "strikethrough": false,
        "underline": false,
        "code": false,
        "color": "default"
       },
       "plain_text": "1) Keep current rule and accept a deadlock. 2) Allow first approval from latest validated lineage candidate when Approved is empty, then enforce normal Parent=Current Approved afterward. 3) Create an artificial v0 Approved baseline.",
       "href": null
      }
