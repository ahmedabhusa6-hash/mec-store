   "type": "paragraph",
   "paragraph": {
    "rich_text": [
     {
      "type": "text",
      "text": {
       "content": "Observed evidence: Microsoft Dynamics 365 Finance documents GL, AP, AR, budgeting, cash/bank, cost accounting, fixed assets and financial reporting; SAP S/4HANA Cloud General Ledger integrates with asset accounting, AP/AR, management accounting, procurement and treasury; Oracle Fusion Cloud Financials includes GL, intercompany, payables, receivables, payments, cash management, tax, expenses and assets; Xero explicitly contrasts accounting software's financial focus with broader ERP scope while noting the boundary can blur.",
       "link": null
      },
      "annotations": {
       "bold": false,
       "italic": false,
       "strikethrough": false,
       "underline": false,
       "code": false,
       "color": "default"
      },
      "plain_text": "Observed evidence: Microsoft Dynamics 365 Finance documents GL, AP, AR, budgeting, cash/bank, cost accounting, fixed assets and financial reporting; SAP S/4HANA Cloud General Ledger integrates with asset accounting, AP/AR, management accounting, procurement and treasury; Oracle Fusion Cloud Financials includes GL, intercompany, payables, receivables, payments, cash management, tax, expenses and assets; Xero explicitly contrasts accounting software's financial focus with broader ERP scope while noting the boundary can blur.",
      "href": null
     }
    ],
    "icon": null,
    "color": "default"
   },
   "archived": false
