  {
   "object": "block",
   "id": "64f138d7-0cfe-470b-8011-6a6f464c537e",
   "parent": {
    "type": "page_id",
    "page_id": "3e658a07-79e8-816b-9bfc-d55ae5d7b437"
   },
   "created_time": "2026-09-25T21:50:00.000Z",
   "last_edited_time": "2026-09-25T21:50:00.000Z",
   "created_by": {
    "object": "user",
    "id": "3a7d872b-594c-8189-8121-000244e53bc8"
   },
   "last_edited_by": {
    "object": "user",
    "id": "3a7d872b-594c-8189-8121-000244e53bc8"
   },
   "has_children": false,
   "in_trash": false,
   "type": "paragraph",
   "paragraph": {
    "rich_text": [
     {
      "type": "text",
      "text": {
       "content": "The reviewed sources converge on a multidimensional marketing knowledge space, but they do not prescribe one canonical flat taxonomy. JM emphasizes substantive marketing questions across topic, theory, method, and level of analysis; JMR explicitly separates substantive, theoretical, and methodological contributions; JCR organizes consumer research around distinct paradigms/themes and multiple levels; Journal of Macromarketing foregrounds marketing–society relations; relationship marketing and service-dominant logic demonstrate distinct theoretical lenses; the 2026 boundarying commentary argues that marketing contribution depends on explanatory mechanisms rather than topical relevance alone.",
       "link": null
      },
      "annotations": {
       "bold": false,
       "italic": false,
       "strikethrough": false,
       "underline": false,
       "code": false,
       "color": "default"
      },
      "plain_text": "The reviewed sources converge on a multidimensional marketing knowledge space, but they do not prescribe one canonical flat taxonomy. JM emphasizes substantive marketing questions across topic, theory, method, and level of analysis; JMR explicitly separates substantive, theoretical, and methodological contributions; JCR organizes consumer research around distinct paradigms/themes and multiple levels; Journal of Macromarketing foregrounds marketing–society relations; relationship marketing and service-dominant logic demonstrate distinct theoretical lenses; the 2026 boundarying commentary argues that marketing contribution depends on explanatory mechanisms rather than topical relevance alone.",
      "href": null
     }
    ],
    "icon": null,
    "color": "default"
   },
   "archived": false
  },
