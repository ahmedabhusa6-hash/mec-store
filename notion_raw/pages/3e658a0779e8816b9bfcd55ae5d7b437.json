   "type": "paragraph",
   "paragraph": {
    "rich_text": [
     {
      "type": "text",
      "text": {
       "content": "Validation decision: SYNTHESIZED, not ACTIVE. Confidence remains Medium because the proposed architecture is a derived design principle. The boundary pass now additionally covers MarTech as a cross-functional technology/IT layer and nonprofit/transformative marketing as contextual/paradigmatic dimensions, while remaining subfield and methodology gaps prevent promotion to ACTIVE.",
       "link": null
      },
      "annotations": {
       "bold": false,
       "italic": false,
       "strikethrough": false,
       "underline": false,
       "code": false,
