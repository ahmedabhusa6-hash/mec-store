   "has_children": false,
   "in_trash": false,
   "type": "paragraph",
   "paragraph": {
    "rich_text": [
     {
      "type": "text",
      "text": {
       "content": "Do not use Vesterinen et al.'s broad novelty sentence as evidence that no unified model previously existed. Preserve the narrower, defensible interpretation: the paper proposed a conceptual framework with a claimed gap that may refer to its particular formulation, mechanism detail, or conceptual scope.",
       "link": null
      },
      "annotations": {
       "bold": false,
       "italic": false,
       "strikethrough": false,
       "underline": false,
       "code": false,
       "color": "default"
      },
      "plain_text": "Do not use Vesterinen et al.'s broad novelty sentence as evidence that no unified model previously existed. Preserve the narrower, defensible interpretation: the paper proposed a conceptual framework with a claimed gap that may refer to its particular formulation, mechanism detail, or conceptual scope.",
      "href": null
     }
    ],
    "icon": null,
    "color": "default"
