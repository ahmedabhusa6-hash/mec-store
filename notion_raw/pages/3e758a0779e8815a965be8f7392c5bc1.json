   "type": "paragraph",
   "paragraph": {
    "rich_text": [
     {
      "type": "text",
      "text": {
       "content": "قاعدة SKU:",
       "link": null
      },
      "annotations": {
       "bold": true,
       "italic": false,
       "strikethrough": false,
       "underline": false,
       "code": false,
       "color": "default"
      },
      "plain_text": "قاعدة SKU:",
      "href": null
     },
     {
      "type": "text",
      "text": {
       "content": " فئة المنتج/الخدمة ليست SKU. الـSKU الفعلي يُثبت بصورة مستقلة، ويجب تحديد الحد الأدنى من السمات التجارية اللازمة للمقارنة قبل ترتيب الأسعار أو اعتبار العروض متطابقة.",
       "link": null
      },
      "annotations": {
       "bold": false,
       "italic": false,
       "strikethrough": false,
       "underline": false,
       "code": false,
       "color": "default"
      },
      "plain_text": " فئة المنتج/الخدمة ليست SKU. الـSKU الفعلي يُثبت بصورة مستقلة، ويجب تحديد الحد الأدنى من السمات التجارية اللازمة للمقارنة قبل ترتيب الأسعار أو اعتبار العروض متطابقة.",
