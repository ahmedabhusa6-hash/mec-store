   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "2366f7d3-5853-4b88-b8ec-1bf45cf9c454",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Never infer Cycle ID or Change ID from numerical order."
   ],
   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "8fc336ef-5a14-440d-8524-c8af90306a96",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Preserve historical records; SUPERSEDED is not DELETED."
