  },
  {
   "id": "e34be834-ad22-48b2-b860-e5bd664657a5",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Notion is the canonical persistent project record for this operation."
   ],
   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "1b4f0d80-e0b0-4d9f-9615-08c0d563b575",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Separate Fact / Evidence / Inference / Assumption / Open / Historical states."
