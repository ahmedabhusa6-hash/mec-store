   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "cf47bbfc-8644-4bb0-ae81-7ba497e3d91d",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Keep Research, Source, Evidence, Claim, Knowledge, Change and Cycle as separate provenance entities."
