   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "59b0e2ee-0fed-4a64-954a-1ba88f145976",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Keep System_Type separate from Functional Scope, Deployment, Architecture, Licensing and contextual dimensions."
   ],
   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "a0c89b0c-8285-47ea-80ee-d0e1c620a88c",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Do not claim success before persistence verification."
   ],
   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "a3990ab1-7075-4f3d-ab26-c7ae13db79b6",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "On write failure: preserve last verified state, record pending correction, reconcile, retry safely."
   ],
   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "090d548b-2bc4-4e2a-beb1-cbd0560af2f0",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Do not use a contextual source as formal taxonomy proof beyond its evidence scope."
