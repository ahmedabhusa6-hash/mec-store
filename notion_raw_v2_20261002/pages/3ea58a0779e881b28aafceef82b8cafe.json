   "created": "2026-09-29T22:45:00.000Z",
   "edited": "2026-09-29T22:45:00.000Z"
  },
  {
   "id": "e2a5ccfd-0354-467b-9283-233db5fa224d",
   "type": "bulleted_list_item",
   "has_children": false,
   "text": [
    "Use Scope-before-Label for System_Type classification."
