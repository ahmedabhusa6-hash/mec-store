   "Statement": {
    "id": "b%3FiZ",
    "type": "rich_text",
    "rich_text": [
     {
      "type": "text",
      "text": {
       "content": "البيانات العامة الرسمية الحالية تثبت وجود طبقة شراكة وتمكين موزعين مرتبطة بـONYX داخل منظومة YemenSoft/Ultimate Solutions. موقع ONYX يصف Ultimate Solutions بأنها مؤسسة شقيقة لـYemenSoft وإحدى مجموعة شركاتها، ويعرض مسارًا للوكلاء/التوزيع؛ كما يعلن Ultimate برنامج شركاء يتضمن دعم المبيعات والتدريب، مواد التسويق والندوات، الدعم الفني، والحوافز المرتبطة بالمبيعات.",
       "link": null
      },
