   "has_children": false,
   "text": [
    "غطينا اليوم موضوع التكامل بالتجزئة. تُعطى صيغة التكامل بالتجزئة كالتالي:"
   ],
   "created": "2026-07-24T22:57:00.000Z",
   "edited": "2026-07-24T22:57:00.000Z"
  },
  {
   "id": "20d58a07-79e8-8351-982f-81608b8aedda",
   "type": "equation",
   "has_children": false,
   "text": [],
