   "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Activation API Documentation</title>\n\n  <style>\n    :root {\n      --bg: #0b0e13;\n      --sidebar: #0f131a;\n      --surface: #131923;\n      --surface-hover: #192231;\n      --code: #0a0d12;\n      --border: #252e3b;\n      --border-light: #344052;\n      --text: #eef2f7;\n      --muted: #8d9aad;\n      --blue: #70a7ff;\n      --blue-soft: rgba(112, 167, 255, .12);\n      --green: #45d483;\n      --green-soft: rgba(69, 212, 131, .12);\n      --yellow: #f4c866;\n      --red: #ff7777;\n      --shadow: 0 20px 60px rgba(0, 0, 0, .25);\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html {\n      scroll-behavior: smooth;\n      background: var(--bg);\n    }\n\n    body {\n      margin: 0;\n      color: var(--text);\n      background:\n        radial-gradient(\n          circle at 70% -10%,\n          rgba(71, 121, 202, .18),\n          transparent 35rem\n        ),\n        var(--bg);\n      font-family:\n        Inter, ui-sans-serif, system-ui, -apple-system,\n        BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.6;\n    }\n\n    button {\n      font: inherit;\n    }\n\n    .mobile-header {\n      display: none;\n    }\n\n    .layout {\n      display: grid;\n      grid-template-columns: 270px minmax(0, 1fr);\n      min-height: 100vh;\n    }\n\n    .sidebar {\n      position: fixed;\n      inset: 0 auto 0 0;\n      z-index: 20;\n      width: 270px;\n      padding: 28px 18px;\n      overflow-y: auto;\n      background: rgba(15, 19, 26, .94);\n      border-right: 1px solid var(--border);\n      backdrop-filter: blur(18px);\n    }\n\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      padding: 0 12px 30px;\n      color: var(--text);\n      font-size: 16px;\n      font-weight: 750;\n      letter-spacing: -.02em;\n    }\n\n    .brand-mark {\n      display: grid;\n      place-items: center;\n      width: 32px;\n      height: 32px;\n      color: #07101d;\n      background: linear-gradient(135deg, #8fc1ff, #528dff);\n      border-radius: 9px;\n      font-size: 14px;\n      font-weight: 900;\n      box-shadow: 0 8px 25px rgba(82, 141, 255, .3);\n    }\n\n    .version {\n      margin-left: auto;\n      padding: 3px 7px;\n      color: var(--muted);\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 5px;\n      font-size: 10px;\n      font-weight: 700;\n    }\n\n    .nav-label {\n      padding: 0 12px 9px;\n      color: #667386;\n      font-size: 10px;\n      font-weight: 800;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .nav {\n      display: grid;\n      gap: 3px;\n      margin-bottom: 28px;\n    }\n\n    .nav a {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 9px 12px;\n      color: var(--muted);\n      border-radius: 7px;\n      font-size: 13px;\n      text-decoration: none;\n      transition: .15s ease;\n    }\n\n    .nav a:hover,\n    .nav a.active {\n      color: var(--text);\n      background: var(--surface-hover);\n    }\n\n    .nav a.active {\n      box-shadow: inset 2px 0 var(--blue);\n    }\n\n    .nav-icon {\n      width: 16px;\n      color: #65758a;\n      text-align: center;\n      font-size: 13px;\n    }\n\n    .main {\n      grid-column: 2;\n      min-width: 0;\n    }\n\n    .topbar {\n      position: sticky;\n      top: 0;\n      z-index: 10;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 70px;\n      padding: 0 6vw;\n      background: rgba(11, 14, 19, .78);\n      border-bottom: 1px solid rgba(37, 46, 59, .7);\n      backdrop-filter: blur(18px);\n    }\n\n    .breadcrumbs {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      color: var(--muted);\n      font-size: 13px;\n    }\n\n    .breadcrumbs strong {\n      color: var(--text);\n      font-weight: 600;\n    }\n\n    .status {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      color: var(--green);\n      font-size: 12px;\n      font-weight: 600;\n    }\n\n    .status-dot {\n      width: 7px;\n      height: 7px;\n      background: var(--green);\n      border-radius: 50%;\n      box-shadow: 0 0 0 4px var(--green-soft);\n    }\n\n    .content {\n      width: min(1100px, calc(100% - 80px));\n      margin: 0 auto;\n      padding: 80px 0 120px;\n    }\n\n    .eyebrow {\n      margin-bottom: 15px;\n      color: var(--blue);\n      font-size: 12px;\n      font-weight: 800;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    h1,\n    h2,\n    h3 {\n      margin: 0;\n      color: var(--text);\n      letter-spacing: -.035em;\n      line-height: 1.2;\n    }\n\n    h1 {\n      max-width: 720px;\n      font-size: clamp(38px, 6vw, 64px);\n    }\n\n    h2 {\n      margin-top: 100px;\n      margin-bottom: 13px;\n      font-size: 30px;\n      scroll-margin-top: 100px;\n    }\n\n    h3 {\n      margin-top: 38px;\n      margin-bottom: 13px;\n      font-size: 18px;\n      scroll-margin-top: 100px;\n    }\n\n    .lead {\n      max-width: 650px;\n      margin: 22px 0 0;\n      color: var(--muted);\n      font-size: 17px;\n    }\n\n    .intro-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 13px;\n      margin-top: 48px;\n    }\n\n    .info-card {\n      padding: 18px;\n      background: rgba(19, 25, 35, .75);\n      border: 1px solid var(--border);\n      border-radius: 10px;\n    }\n\n    .info-card-label {\n      margin-bottom: 8px;\n      color: var(--muted);\n      font-size: 11px;\n      font-weight: 750;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .info-card-value {\n      color: var(--text);\n      font-size: 14px;\n      font-weight: 600;\n    }\n\n    .endpoint {\n      margin-top: 26px;\n      overflow: hidden;\n      background: rgba(19, 25, 35, .86);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      box-shadow: var(--shadow);\n    }\n\n    .endpoint-header {\n      display: flex;\n      align-items: center;\n      gap: 13px;\n      padding: 16px 19px;\n      background: rgba(255, 255, 255, .018);\n      border-bottom: 1px solid var(--border);\n    }\n\n    .method {\n      padding: 5px 8px;\n      color: #06160d;\n      background: var(--green);\n      border-radius: 5px;\n      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n      font-size: 11px;\n      font-weight: 900;\n    }\n\n    .path {\n      overflow: auto;\n      color: #dfe8f3;\n      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n      font-size: 13px;\n      white-space: nowrap;\n    }\n\n    .endpoint-body {\n      padding: 24px;\n    }\n\n    .endpoint-description {\n      margin: 0 0 24px;\n      color: var(--muted);\n      font-size: 14px;\n    }\n\n    .section-label {\n      margin: 25px 0 10px;\n      color: #c5d0df;\n      font-size: 11px;\n      font-weight: 800;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n    }\n\n    .code-wrap {\n      position: relative;\n      margin: 0;\n      overflow: hidden;\n      background: var(--code);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n    }\n\n    pre {\n      overflow-x: auto;\n      margin: 0;\n      padding: 20px;\n      color: #d9e5f2;\n      font: 13px/1.75 ui-monospace, SFMono-Regular, Consolas, monospace;\n    }\n\n    .copy-button {\n      position: absolute;\n      top: 9px;\n      right: 9px;\n      padding: 6px 9px;\n      color: var(--muted);\n      background: #151c27;\n      border: 1px solid var(--border-light);\n      border-radius: 5px;\n      cursor: pointer;\n      font-size: 11px;\n      font-weight: 700;\n      transition: .15s ease;\n    }\n\n    .copy-button:hover {\n      color: white;\n      border-color: var(--blue);\n      background: #1b2a3d;\n    }\n\n    .copy-button.copied {\n      color: var(--green);\n      border-color: var(--green);\n    }\n\n    .parameter-table {\n      width: 100%;\n      overflow: hidden;\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      border-collapse: separate;\n      border-spacing: 0;\n    }\n\n    .parameter-table th,\n    .parameter-table td {\n      padding: 13px 15px;\n      border-bottom: 1px solid var(--border);\n      text-align: left;\n      vertical-align: top;\n    }\n\n    .parameter-table tr:last-child td {\n      border-bottom: 0;\n    }\n\n    .parameter-table th {\n      color: var(--muted);\n      background: rgba(255, 255, 255, .025);\n      font-size: 11px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .parameter-table td {\n      color: #bdc9d7;\n      font-size: 13px;\n    }\n\n    .parameter-table td:first-child {\n      color: #dce9f8;\n      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n      font-weight: 600;\n    }\n\n    .type {\n      color: var(--blue);\n    }\n\n    .required {\n      color: var(--yellow);\n    }\n\n    .note {\n      display: flex;\n      gap: 12px;\n      margin-top: 20px;\n      padding: 15px 17px;\n      color: #c3cedb;\n      background: var(--blue-soft);\n      border: 1px solid rgba(112, 167, 255, .2);\n      border-radius: 8px;\n      font-size: 13px;\n    }\n\n    .note-icon {\n      color: var(--blue);\n      font-weight: 900;\n    }\n\n    .status-code {\n      display: inline-block;\n      margin-right: 10px;\n      min-width: 40px;\n      color: var(--green);\n      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n      font-weight: 700;\n    }\n\n    .status-code.client {\n      color: var(--yellow);\n    }\n\n    .status-code.rate {\n      color: var(--red);\n    }\n\n    .footer {\n      margin-top: 110px;\n      padding-top: 25px;\n      color: #68778a;\n      border-top: 1px solid var(--border);\n      font-size: 12px;\n    }\n\n    @media (max-width: 850px) {\n      .layout {\n        display: block;\n      }\n\n      .mobile-header {\n        position: sticky;\n        top: 0;\n        z-index: 30;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        height: 62px;\n        padding: 0 18px;\n        background: rgba(15, 19, 26, .94);\n        border-bottom: 1px solid var(--border);\n        backdrop-filter: blur(18px);\n      }\n\n      .mobile-menu {\n        padding: 7px 10px;\n        color: var(--text);\n        background: var(--surface);\n        border: 1px solid var(--border);\n        border-radius: 6px;\n        cursor: pointer;\n      }\n\n      .sidebar {\n        display: none;\n        position: fixed;\n        top: 62px;\n        width: 270px;\n        height: calc(100vh - 62px);\n      }\n\n      .sidebar.open {\n        display: block;\n      }\n\n      .main {\n        display: block;\n      }\n\n      .topbar {\n        display: none;\n      }\n\n      .content {\n        width: min(100% - 36px, 1100px);\n        padding: 55px 0 80px;\n      }\n\n      .intro-grid {\n        grid-template-columns: 1fr;\n      }\n    }\n\n    @media (max-width: 600px) {\n      .content {\n        width: min(100% - 26px, 1100px);\n      }\n\n      h1 {\n        font-size: 39px;\n      }\n\n      h2 {\n        margin-top: 70px;\n        font-size: 25px;\n      }\n\n      .endpoint-body {\n        padding: 17px;\n      }\n\n      .parameter-table {\n        display: block;\n        overflow-x: auto;\n        white-space: nowrap;\n      }\n\n      .parameter-table td,\n      .parameter-table th {\n        padding: 11px;\n      }\n    }\n  </style>\n</head>\n\n<body>\n  <header class=\"mobile-header\">\n    <div class=\"brand\">\n      <span class=\"brand-mark\">A</span>\n      Activation API\n    </div>\n\n    <button class=\"mobile-menu\" id=\"menuButton\" aria-label=\"Open navigation\">\n      ☰\n    </button>\n  </header>\n\n  <div class=\"layout\">\n    <aside class=\"sidebar\" id=\"sidebar\">\n      <div class=\"brand\">\n        <span class=\"brand-mark\">A</span>\n        Activation API\n        <span class=\"version\">v1</span>\n      </div>\n\n      <div class=\"nav-label\">Documentation</div>\n\n      <nav class=\"nav\">\n        <a class=\"active\" href=\"#overview\">\n          <span class=\"nav-icon\">⌂</span>\n          Overview\n        </a>\n\n        <a href=\"#buy-activation\">\n          <span class=\"nav-icon\">↗</span>\n          Buy Activation\n        </a>\n        \n        <a href=\"#account-balance\">\n          <span class=\"nav-icon\">$</span>\n          Account Balance\n        </a>\n\n        <a href=\"#services\">\n          <span class=\"nav-icon\">▦</span>\n          Services\n        </a>\n\n        <a href=\"#history\">\n          <span class=\"nav-icon\">◷</span>\n          Activation History\n        </a>\n      </nav>\n\n      <div class=\"nav-label\">Resources</div>\n\n      <nav class=\"nav\">\n        <a href=\"#status-codes\">\n          <span class=\"nav-icon\">✓</span>\n          Status Codes\n        </a>\n\n        <a href=\"#pagination\">\n          <span class=\"nav-icon\">≡</span>\n          Pagination\n        </a>\n      </nav>\n    </aside>\n\n    <main class=\"main\">\n      <div class=\"topbar\">\n        <div class=\"breadcrumbs\">\n          Documentation <span>/</span>\n          <strong>Activation API</strong>\n        </div>\n\n        <div class=\"status\">\n          <span class=\"status-dot\"></span>\n          All systems operational\n        </div>\n      </div>\n\n      <div class=\"content\">\n        <section id=\"overview\">\n          <div class=\"eyebrow\">Developer Documentation</div>\n\n          <h1>Activation API</h1>\n\n          <p class=\"lead\">\n            Purchase activation services and retrieve activation history\n            through a simple HTTP API.\n          </p>\n\n          <div class=\"intro-grid\">\n            <div class=\"info-card\">\n              <div class=\"info-card-label\">Base URL</div>\n              <div class=\"info-card-value\">https://api.acczone.xyz</div>\n            </div>\n\n            <div class=\"info-card\">\n              <div class=\"info-card-label\">Authentication</div>\n              <div class=\"info-card-value\">API key via query parameter</div>\n            </div>\n\n            <div class=\"info-card\">\n              <div class=\"info-card-label\">Format</div>\n              <div class=\"info-card-value\">JSON responses</div>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"buy-activation\">\n          <h2>Buy Activation</h2>\n\n          <p class=\"lead\">\n            Purchase one or more activation services from available stock.\n          </p>\n\n          <div class=\"endpoint\">\n            <div class=\"endpoint-header\">\n              <span class=\"method\">GET</span>\n              <code class=\"path\">/buyCpn</code>\n            </div>\n\n            <div class=\"endpoint-body\">\n              <p class=\"endpoint-description\">\n                Creates a new activation purchase.\n              </p>\n\n              <div class=\"section-label\">Request URL</div>\n\n              <div class=\"code-wrap\">\n                <button class=\"copy-button\" data-copy-target=\"buy-url\">\n                  Copy\n                </button>\n\n                <pre id=\"buy-url\">https://api.acczone.xyz/buyCpn?apikey=YOUR_API_KEY&amp;service_key=gemini&amp;quantity=1</pre>\n              </div>\n\n              <div class=\"section-label\">Query Parameters</div>\n\n              <table class=\"parameter-table\">\n                <thead>\n                  <tr>\n                    <th>Parameter</th>\n                    <th>Type</th>\n                    <th>Required</th>\n                    <th>Description</th>\n                  </tr>\n                </thead>\n\n                <tbody>\n                  <tr>\n                    <td>apikey</td>\n                    <td class=\"type\">string</td>\n                    <td class=\"required\">Yes</td>\n                    <td>Your API authentication key.</td>\n                  </tr>\n\n                  <tr>\n                    <td>service_key</td>\n                    <td class=\"type\">string</td>\n                    <td class=\"required\">Yes</td>\n                    <td>The service to purchase. Use <code>gemini</code>.</td>\n                  </tr>\n\n                  <tr>\n                    <td>quantity</td>\n                    <td class=\"type\">integer</td>\n                    <td class=\"required\">Yes</td>\n                    <td>\n                      Number of activations to purchase. A value of\n                      <code>1</code> is recommended.\n                    </td>\n                  </tr>\n                </tbody>\n              </table>\n\n              <div class=\"section-label\">Example Response</div>\n\n              <div class=\"code-wrap\">\n                <button class=\"copy-button\" data-copy-target=\"buy-response\">\n                  Copy\n                </button>\n\n                <pre id=\"buy-response\">[\n  {\n    \"id\": 12345,\n    \"service_key\": \"gemini\",\n    \"code_type\": \"text\",\n    \"code_value\": \"LINK_HERE_COUPON_HERE\",\n    \"is_used\": 1,\n    \"used_by\": 123456789,\n    \"used_at\": \"2026-09-09 07:10:07\",\n    \"extracted_code\": null\n  }\n]</pre>\n              </div>\n\n              <div class=\"note\">\n                <span class=\"note-icon\">!</span>\n                <span>\n                  Stock may sell out instantly. A quantity of\n                  <code>1</code> is recommended.\n                </span>\n              </div>\n            </div>\n          </div>\n        </section>\n<section id=\"account-balance\">\n  <h2>Account Balance</h2>\n\n  <p class=\"lead\">\n    Retrieve your account information and current API balance.\n  </p>\n\n  <div class=\"endpoint\">\n    <div class=\"endpoint-header\">\n      <span class=\"method\">GET</span>\n      <code class=\"path\">/getBalance</code>\n    </div>\n\n    <div class=\"endpoint-body\">\n      <p class=\"endpoint-description\">\n        Returns account details, API key information, and the current balance.\n      </p>\n\n      <div class=\"section-label\">Request URL</div>\n\n      <div class=\"code-wrap\">\n        <button class=\"copy-button\" data-copy-target=\"balance-url\">\n          Copy\n        </button>\n\n        <pre id=\"balance-url\">https://api.acczone.xyz/getBalance?apikey=YOUR_API_KEY</pre>\n      </div>\n\n      <div class=\"section-label\">Query Parameters</div>\n\n      <table class=\"parameter-table\">\n        <thead>\n          <tr>\n            <th>Parameter</th>\n            <th>Type</th>\n            <th>Required</th>\n            <th>Description</th>\n          </tr>\n        </thead>\n\n        <tbody>\n          <tr>\n            <td>apikey</td>\n            <td class=\"type\">string</td>\n            <td class=\"required\">Yes</td>\n            <td>Your API authentication key.</td>\n          </tr>\n        </tbody>\n      </table>\n\n      <div class=\"section-label\">Example Response</div>\n\n      <div class=\"code-wrap\">\n        <button class=\"copy-button\" data-copy-target=\"balance-response\">\n          Copy\n        </button>\n\n        <pre id=\"balance-response\">{\n  \"user_id\": 1234567890,\n  \"username\": \"johndoe\",\n  \"first_name\": \"John Doe\",\n  \"balance\": 451.88,\n  \"created_at\": \"2026-09-01 19:49:55\",\n  \"verified_at\": \"2026-09-01 19:49:55\",\n  \"apikey\": \"KEY\"\n}</pre>\n      </div>\n\n      <div class=\"note\">\n        <span class=\"note-icon\">!</span>\n        <span>\n          Do not expose your API key publicly or commit it to client-side\n          applications.\n        </span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"services\">\n  <h2>Available Services</h2>\n\n  <p class=\"lead\">\n    Retrieve the list of activation services currently available through the API.\n  </p>\n\n  <div class=\"endpoint\">\n    <div class=\"endpoint-header\">\n      <span class=\"method\">GET</span>\n      <code class=\"path\">/getServices</code>\n    </div>\n\n    <div class=\"endpoint-body\">\n      <p class=\"endpoint-description\">\n        Returns an array of available activation services, including their\n        service keys, prices, and active status.\n      </p>\n\n      <div class=\"section-label\">Request URL</div>\n\n      <div class=\"code-wrap\">\n        <button class=\"copy-button\" data-copy-target=\"services-url\">\n          Copy\n        </button>\n\n        <pre id=\"services-url\">https://api.acczone.xyz/getServices</pre>\n      </div>\n\n      <div class=\"section-label\">Example Response</div>\n\n      <div class=\"code-wrap\">\n        <button class=\"copy-button\" data-copy-target=\"services-response\">\n          Copy\n        </button>\n\n        <pre id=\"services-response\">[\n  {\n    \"key\": \"gemini\",\n    \"name\": \"Gemini Link\",\n    \"price\": 0.4,\n    \"is_active\": 1,\n    \"created_at\": \"2026-09-01 12:25:23\"\n  }\n]</pre>\n      </div>\n\n      <div class=\"section-label\">Response Fields</div>\n\n      <table class=\"parameter-table\">\n        <thead>\n          <tr>\n            <th>Field</th>\n            <th>Type</th>\n            <th>Description</th>\n          </tr>\n        </thead>\n\n        <tbody>\n          <tr>\n            <td>key</td>\n            <td class=\"type\">string</td>\n            <td>Unique service key used when purchasing an activation.</td>\n          </tr>\n\n          <tr>\n            <td>name</td>\n            <td class=\"type\">string</td>\n            <td>Display name of the service.</td>\n          </tr>\n\n          <tr>\n            <td>price</td>\n            <td class=\"type\">number</td>\n            <td>Price per activation.</td>\n          </tr>\n\n          <tr>\n            <td>is_active</td>\n            <td class=\"type\">integer</td>\n            <td>\n              Service status. <code>1</code> means active and <code>0</code>\n              means inactive.\n            </td>\n          </tr>\n\n          <tr>\n            <td>created_at</td>\n            <td class=\"type\">string</td>\n            <td>Date and time when the service was created.</td>\n          </tr>\n        </tbody>\n      </table>\n\n      <div class=\"note\">\n        <span class=\"note-icon\">!</span>\n        <span>\n          Only services with <code>is_active</code> equal to <code>1</code>\n          should be used for new purchases.\n        </span>\n      </div>\n    </div>\n  </div>\n</section>\n        \n        <section id=\"history\">\n          <h2>Activation History</h2>\n\n          <p class=\"lead\">\n            Retrieve previously created activation records using pagination.\n          </p>\n\n          <div class=\"endpoint\">\n            <div class=\"endpoint-header\">\n              <span class=\"method\">GET</span>\n              <code class=\"path\">/getHistory</code>\n            </div>\n\n            <div class=\"endpoint-body\">\n              <p class=\"endpoint-description\">\n                Returns a paginated list of activation records.\n              </p>\n\n              <div class=\"section-label\">Request URL</div>\n\n              <div class=\"code-wrap\">\n                <button class=\"copy-button\" data-copy-target=\"history-url\">\n                  Copy\n                </button>\n\n                <pre id=\"history-url\">https://api.acczone.xyz/getHistory?apikey=YOUR_API_KEY&amp;page=1&amp;limit=20</pre>\n              </div>\n\n              <div class=\"section-label\">Query Parameters</div>\n\n              <table class=\"parameter-table\">\n                <thead>\n                  <tr>\n                    <th>Parameter</th>\n                    <th>Type</th>\n                    <th>Required</th>\n                    <th>Description</th>\n                  </tr>\n                </thead>\n\n                <tbody>\n                  <tr>\n                    <td>apikey</td>\n                    <td class=\"type\">string</td>\n                    <td class=\"required\">Yes</td>\n                    <td>Your API authentication key.</td>\n                  </tr>\n\n                  <tr>\n                    <td>page</td>\n                    <td class=\"type\">integer</td>\n                    <td class=\"required\">Yes</td>\n                    <td>Page number to retrieve, starting from <code>1</code>.</td>\n                  </tr>\n\n                  <tr>\n                    <td>limit</td>\n                    <td class=\"type\">integer</td>\n                    <td class=\"required\">Yes</td>\n                    <td>Number of records to return. Maximum: <code>100</code>.</td>\n                  </tr>\n                </tbody>\n              </table>\n\n              <div class=\"section-label\">Example Response</div>\n\n              <div class=\"code-wrap\">\n                <button class=\"copy-button\" data-copy-target=\"history-response\">\n                  Copy\n                </button>\n\n                <pre id=\"history-response\">[\n  {\n    \"id\": 67149,\n    \"service_key\": \"test181\",\n    \"code_value\": \"Testing42\",\n    \"used_at\": \"2026-09-09 07:10:07\"\n  },\n  {\n    \"id\": 66815,\n    \"service_key\": \"test181\",\n    \"code_value\": \"Testing4\",\n    \"used_at\": \"2026-09-09 06:34:55\"\n  },\n  {\n    \"id\": 66814,\n    \"service_key\": \"test181\",\n    \"code_value\": \"Testing3\",\n    \"used_at\": \"2026-09-09 06:33:24\"\n  }\n]\n</pre>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"status-codes\">\n          <h2>HTTP Status Codes</h2>\n\n          <div class=\"endpoint\">\n            <div class=\"endpoint-body\">\n              <table class=\"parameter-table\">\n                <thead>\n                  <tr>\n                    <th>Status</th>\n                    <th>Description</th>\n                  </tr>\n                </thead>\n\n                <tbody>\n                  <tr>\n                    <td>\n                      <span class=\"status-code\">200</span>\n                      OK\n                    </td>\n                    <td>Request completed successfully.</td>\n                  </tr>\n\n                  <tr>\n                    <td>\n                      <span class=\"status-code client\">400</span>\n                      Bad Request\n                    </td>\n                    <td>\n                      The request contains an invalid parameter or another API\n                      error.\n                    </td>\n                  </tr>\n\n                  <tr>\n                    <td>\n                      <span class=\"status-code rate\">429</span>\n                      Too Many Requests\n                    </td>\n                    <td>\n                      Rate limit exceeded. Maximum of one request every\n                      two seconds.\n                    </td>\n                  </tr>\n                </tbody>\n              </table>\n\n              <div class=\"section-label\">Error Response</div>\n\n              <div class=\"code-wrap\">\n                <button class=\"copy-button\" data-copy-target=\"error-response\">\n                  Copy\n                </button>\n\n                <pre id=\"error-response\">{\n  \"detail\": \"ERROR HERE\"\n}</pre>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"pagination\">\n          <h2>Pagination</h2>\n\n          <p class=\"lead\">\n            The history endpoint uses page-based pagination.\n          </p>\n\n          <div class=\"endpoint\">\n            <div class=\"endpoint-body\">\n              <table class=\"parameter-table\">\n                <thead>\n                  <tr>\n                    <th>Parameter</th>\n                    <th>Rules</th>\n                  </tr>\n                </thead>\n\n                <tbody>\n                  <tr>\n                    <td>page</td>\n                    <td>Starts at <code>1</code>.</td>\n                  </tr>\n\n                  <tr>\n                    <td>limit</td>\n                    <td>Minimum <code>1</code>, maximum <code>100</code>.</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </section>\n\n        <footer class=\"footer\">\n          Activation API Documentation · API version 1\n        </footer>\n      </div>\n    </main>\n  </div>\n\n  <script>\n    document.querySelectorAll(\".copy-button\").forEach(function (button) {\n      button.addEventListener(\"click\", async function () {\n        var targetId = button.getAttribute(\"data-copy-target\");\n        var target = document.getElementById(targetId);\n\n        if (!target) return;\n\n        try {\n          await navigator.clipboard.writeText(target.textContent.trim());\n\n          var originalText = button.textContent;\n          button.textContent = \"Copied\";\n          button.classList.add(\"copied\");\n\n          setTimeout(function () {\n            button.textContent = originalText;\n            button.classList.remove(\"copied\");\n          }, 1600);\n        } catch (error) {\n          button.textContent = \"Failed\";\n\n          setTimeout(function () {\n            button.textContent = \"Copy\";\n          }, 1600);\n        }\n      });\n    });\n\n    var menuButton = document.getElementById(\"menuButton\");\n    var sidebar = document.getElementById(\"sidebar\");\n\n    menuButton.addEventListener(\"click\", function () {\n      sidebar.classList.toggle(\"open\");\n    });\n\n    document.querySelectorAll(\".nav a\").forEach(function (link) {\n      link.addEventListener(\"click\", function () {\n        sidebar.classList.remove(\"open\");\n\n        document.querySelectorAll(\".nav a\").forEach(function (item) {\n          item.classList.remove(\"active\");\n        });\n\n        link.classList.add(\"active\");\n      });\n    });\n\n    var sections = document.querySelectorAll(\"section[id]\");\n    var navLinks = document.querySelectorAll(\".nav a\");\n\n    var observer = new IntersectionObserver(\n      function (entries) {\n        entries.forEach(function (entry) {\n          if (!entry.isIntersecting) return;\n\n          navLinks.forEach(function (link) {\n            link.classList.toggle(\n              \"active\",\n              link.getAttribute(\"href\") === \"#\" + entry.target.id\n            );\n          });\n        });\n      },\n      {\n        rootMargin: \"-100px 0px -65% 0px\"\n      }\n    );\n\n    sections.forEach(function (section) {\n      observer.observe(section);\n    });\n  </script>\n</body>\n</html>\n",
